# Walmart Scraper Environment Configuration Example
# Copy this file to .env and fill in credentials as needed

# ── Residential Rotating Proxy (Required for live Walmart page scraping) ──────
PROXY_HOST=residential.proxy-provider.com
PROXY_PORT=8080
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password

# ── Walmart Developer / Partner API (Optional) ────────────────────────────────
WALMART_CONSUMER_ID=your-walmart-consumer-id
WALMART_API_KEY=your-walmart-api-key
WALMART_PRIVATE_KEY=your-walmart-private-key

# ── Server & Runtime Options ──────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
CSV_DELIMITER=;
DB_PATH=data/walmart.db
CHECKPOINT_PATH=data/checkpoint.json
LOG_DIR=logs
